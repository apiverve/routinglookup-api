            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "routinglookup",
        "routing number lookup api",
        "bank routing number lookup api",
        "routing number validation api",
        "routing number api",
        "bank routing number api"
    ],
    "homepage": "https://apiverve.com/marketplace/routinglookup?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/routinglookup",
        "source": "https://github.com/apiverve/routinglookup-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
